# Copy to .env.local for local development. Do not commit .env.local.

# WordPress API (use the cms host, not the public www site)
WORDPRESS_URL=https://cms.brownpoliticalreview.org/

# Optional: media host if uploads are served elsewhere
# WORDPRESS_MEDIA_URL=https://cms.brownpoliticalreview.org/

# Optional: used for cache revalidation in production
# REVALIDATION_SECRET=

# Optional local SSH notes only (never put these on Vercel)
# DROPLET_SSH_HOST=
# DROPLET_SSH_USER=root
